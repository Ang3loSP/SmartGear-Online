@model SmartGear_Online.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "_Layout";
}

<div class="container my-5" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                <i class="fas fa-edit me-2"></i>Edit Product
            </h4>
        </div>
        <div class="card-body p-4">

            <form asp-action="Edit" asp-route-id="@Model.ProductId" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <input type="hidden" asp-for="ProductId" />

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label fw-semibold"></label>
                    <input asp-for="ProductName" class="form-control" placeholder="e.g. Nike Custom Jersey 2024">
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <select asp-for="Category" class="form-select">
                        <option value="">-- Select category --</option>
                        <option value="Jerseys">Jerseys</option>
                        <option value="Shoes">Shoes</option>
                        <option value="Gear">Gear</option>
                        <option value="Hats">Hats</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01">
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Describe the product..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg">
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mt-2">
                            <small class="text-muted">Current image:</small>
                            <img src="@Model.ImageUrl" alt="@Model.ProductName"
                                 class="d-block mt-1 rounded"
                                 style="max-height: 120px; max-width: 200px; object-fit: cover;">
                        </div>
                    }
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label asp-for="QuantityInStock" class="form-label fw-semibold"></label>
                        <input asp-for="QuantityInStock" class="form-control" type="number" min="0">
                        <span asp-validation-for="QuantityInStock" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ReorderLevel" class="form-label fw-semibold"></label>
                        <input asp-for="ReorderLevel" class="form-control" type="number" min="1">
                        <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox">
                        <label asp-for="IsActive" class="form-check-label">Active (visible to customers)</label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.ProductId"
                       class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
