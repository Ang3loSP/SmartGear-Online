@* 
    Homepage (Home/Index.cshtml)
    Purpose: Display homepage with hero section, featured products, and benefits
    Question 4: Views - Razor templates with Bootstrap
*@

@model dynamic

@{
    ViewData["Title"] = "Home - SmartGear Online";
}

<!-- Hero Section with Call-to-Action -->
<div class="hero-section" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/hero-bg-stadium.jpg'); background-size: cover; background-position: center; color: white; padding: 120px 0; text-align: center; margin-bottom: 50px;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">Welcome to SmartGear Online</h1>
        <p class="lead mb-4">Customize Your Team Gear - Fast, Easy & Professional</p>

        <!-- Call-to-Action Button -->
        <a asp-action="Index" asp-controller="Product" class="btn btn-primary btn-lg me-3">
            <i class="fas fa-shopping-bag me-2"></i> SHOP NOW
        </a>

        <a href="#featured" class="btn btn-outline-light btn-lg">
            <i class="fas fa-arrow-down me-2"></i> See Featured Products
        </a>
    </div>
</div>

<!-- Featured Products Section -->
<section id="featured" class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Featured Products</h2>

        <div class="row">
            @* Product Card 1 *@
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm product-card h-100">
                    <img src="~/images/products/jersey1.jpg" class="card-img-top" alt="Nike Custom Jersey" style="height: 250px; object-fit: cover;">

                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-primary mb-2">Jerseys</span>
                        <h5 class="card-title">Nike Custom Jersey 2024</h5>
                        <p class="card-text text-muted flex-grow-1">
                            High-quality custom team jersey with personalized name & number customization options.
                        </p>

                        <div class="mb-3">
                            <h6 class="text-primary fw-bold">$89.99</h6>
                            <small class="text-success">✓ In Stock (50 available)</small>
                        </div>

                        <div class="btn-group w-100" role="group">
                            <a asp-action="Details" asp-controller="Product" asp-route-id="1"
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-info-circle me-1"></i> Details
                            </a>

                            <a asp-action="Create" asp-controller="Customization" asp-route-productId="1"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-palette me-1"></i> Customize
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @* Product Card 2 *@
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm product-card h-100">
                    <img src="~/images/products/shoe1.jpg" class="card-img-top" alt="Adidas Soccer Shoe" style="height: 250px; object-fit: cover;">

                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-success mb-2">Shoes</span>
                        <h5 class="card-title">Adidas Soccer Shoe Professional</h5>
                        <p class="card-text text-muted flex-grow-1">
                            Professional soccer shoes with customizable color options and team branding.
                        </p>

                        <div class="mb-3">
                            <h6 class="text-primary fw-bold">$129.99</h6>
                            <small class="text-success">✓ In Stock (35 available)</small>
                        </div>

                        <div class="btn-group w-100" role="group">
                            <a asp-action="Details" asp-controller="Product" asp-route-id="2"
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-info-circle me-1"></i> Details
                            </a>

                            <a asp-action="Create" asp-controller="Customization" asp-route-productId="2"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-palette me-1"></i> Customize
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @* Product Card 3 *@
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm product-card h-100">
                    <img src="~/images/products/gear1.jpg" class="card-img-top" alt="Sports Training Gear" style="height: 250px; object-fit: cover;">

                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-warning mb-2">Gear</span>
                        <h5 class="card-title">Sports Training Gear Set</h5>
                        <p class="card-text text-muted flex-grow-1">
                            Complete training gear set with team logo embroidery and custom color matching.
                        </p>

                        <div class="mb-3">
                            <h6 class="text-primary fw-bold">$199.99</h6>
                            <small class="text-success">✓ In Stock (20 available)</small>
                        </div>

                        <div class="btn-group w-100" role="group">
                            <a asp-action="Details" asp-controller="Product" asp-route-id="3"
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-info-circle me-1"></i> Details
                            </a>

                            <a asp-action="Create" asp-controller="Customization" asp-route-productId="3"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-palette me-1"></i> Customize
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- View All Products Button -->
        <div class="text-center mt-4">
            <a asp-action="Index" asp-controller="Product" class="btn btn-primary btn-lg">
                View All Products <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

