@model Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-sm border-success">
                <div class="card-body p-5">
                    <i class="fas fa-check-circle fa-5x text-success mb-4"></i>
                    <h1 class="mb-3">Thank You!</h1>
                    <p class="lead">Your order has been placed successfully.</p>
                    <p class="text-muted">Order #@Model.OrderId</p>

                    <div class="alert alert-info">
                        A confirmation email has been sent to your email address.
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Order" asp-action="Track" asp-route-id="@Model.OrderId" class="btn btn-primary">
                            <i class="fas fa-truck me-2"></i> Track Order
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary ms-2">
                            <i class="fas fa-shopping-bag me-2"></i> Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 mx-auto">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <p><strong>Order Date:</strong> @Model.OrderDate.ToString("MMMM d, yyyy")</p>
                    <p><strong>Status:</strong> <span class="badge bg-warning">@Model.Status</span></p>
                    <p><strong>Total Amount:</strong> <span class="text-primary fw-bold">$@Model.TotalPrice.ToString("F2")</span></p>
                    <p><strong>Shipping Address:</strong><br>@Model.ShippingAddress</p>
                </div>
            </div>
        </div>
    </div>
</div>