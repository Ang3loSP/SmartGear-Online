@model List<Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container my-5">
    <h1 class="mb-4">My Orders</h1>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@order.OrderId</td>
                                <td>@order.OrderDate.ToString("MMM d, yyyy")</td>
                                <td>@order.OrderItems?.Count ?? 0 items</td>
                                <td class="text-primary fw-bold">$@order.TotalPrice.ToString("F2")</td>
                                <td>
                                    @{
                                        var statusClass = order.Status switch
                                        {
                                            "Pending" => "bg-warning",
                                            "Confirmed" => "bg-info",
                                            "Shipped" => "bg-success",
                                            "Delivered" => "bg-secondary",
                                            _ => "bg-dark"
                                        };
                                    }
                                    <span class="badge @statusClass">@order.Status</span>
                                </td>
                                <td>
                                    <a asp-controller="Order" asp-action="Track" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">
                                        Track
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <h3>No Orders Yet</h3>
            <p class="text-muted">You haven't placed any orders yet.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary">Start Shopping</a>
        </div>
    }
</div>