@*
    Order Tracking Page (Order/Track.cshtml)
    Purpose: Display order status with timeline and real-time updates
    Question 4: Views - Order tracking with status timeline
*@

@using SmartGear_Online.Models
@model Order

@{
    ViewData["Title"] = "Track Order #" + Model.OrderId;
}

<link rel="stylesheet" href="~/css/track.css" />

<div class="container my-5">
    <div class="text-center mb-5">
        <h1>Track Your Order</h1>
        <p class="text-muted">Order <span class="fw-bold">#@Model.OrderId</span></p>
    </div>

    <div class="row">
        <!-- TRACKING TIMELINE (LEFT) -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-route me-2"></i> Order Status Timeline
                    </h5>
                </div>

                <div class="card-body px-4 py-5">
                    <div class="timeline">
                        <!-- Step 1: Pending -->
                        <div class="timeline-item">
                            <div class="timeline-marker completed">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h6 class="fw-bold">Order Received</h6>
                                <p class="text-muted small mb-1">Your order has been received and is being processed</p>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    @Model.OrderDate.ToString("MMMM d, yyyy 'at' h:mm tt")
                                </small>
                            </div>
                        </div>

                        <!-- Step 2: Confirmed -->
                        <div class="timeline-item">
                            <div class="timeline-marker @(Model.Status != "Pending" ? "completed" : "")">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h6 class="fw-bold">Order Confirmed</h6>
                                <p class="text-muted small mb-1">Your order has been confirmed and is being prepared</p>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    @if (Model.Status != "Pending")
                                    {
                                        <span>@Model.OrderDate.AddDays(1).ToString("MMMM d, yyyy 'at' h:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span>Pending</span>
                                    }
                                </small>
                            </div>
                        </div>

                        <!-- Step 3: In Production -->
                        <div class="timeline-item">
                            <div class="timeline-marker @(Model.Status == "In Production" || Model.Status == "Shipped" || Model.Status == "Delivered" ? "completed" : "")
                                         @(Model.Status == "In Production" ? "current" : "")">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h6 class="fw-bold">
                                    <i class="fas fa-tools me-2"></i> In Production
                                    @if (Model.Status == "In Production")
                                    {
                                        <span class="badge bg-warning text-dark ms-2">CURRENT</span>
                                    }
                                </h6>
                                <p class="text-muted small mb-1">Your custom gear is being assembled</p>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    Expected @Model.OrderDate.AddDays(3).ToString("MMMM d, yyyy")
                                </small>
                            </div>
                        </div>

                        <!-- Step 4: Shipped -->
                        <div class="timeline-item">
                            <div class="timeline-marker @(Model.Status == "Shipped" || Model.Status == "Delivered" ? "completed" : "")">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h6 class="fw-bold">Order Shipped</h6>
                                <p class="text-muted small mb-1">Your order is on its way to you!</p>
                                @if (Model.Status == "Shipped" || Model.Status == "Delivered")
                                {
                                    <p class="small mb-2">
                                        <strong>Tracking Number:</strong>
                                        <span class="font-monospace">@(Model.TrackingNumber ?? "FDX123456789")</span>
                                    </p>
                                    <p class="small mb-2"><strong>Carrier:</strong> FedEx</p>
                                }
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    Expected @Model.OrderDate.AddDays(5).ToString("MMMM d, yyyy")
                                </small>
                            </div>
                        </div>

                        <!-- Step 5: Delivered -->
                        <div class="timeline-item">
                            <div class="timeline-marker @(Model.Status == "Delivered" ? "completed" : "")">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h6 class="fw-bold">Delivered</h6>
                                <p class="text-muted small mb-1">Your order has been successfully delivered</p>
                                @if (Model.Status == "Delivered")
                                {
                                    <small class="text-success">
                                        <i class="fas fa-check-circle me-1"></i>
                                        Delivered on @Model.OrderDate.AddDays(8).ToString("MMMM d, yyyy 'at' h:mm tt")
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>
                                        Expected @Model.OrderDate.AddDays(8).ToString("MMMM d, yyyy")
                                    </small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ORDER DETAILS CARD -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-box me-2"></i> Order Details</h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderItems != null && Model.OrderItems.Any())
                            {
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Product?.ProductName ?? "Product"</strong>
                                        </td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.UnitPrice.ToString("F2")</td>
                                        <td>$@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No items found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-body bg-light">
                    <div class="row">
                        <div class="col-md-8"></div>
                        <div class="col-md-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal:</span>
                                <span>$@(Model.OrderItems?.Sum(x => x.Quantity * x.UnitPrice) ?? 0).ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                                <span>Tax (8%):</span>
                                <span>$@(((Model.OrderItems?.Sum(x => x.Quantity * x.UnitPrice) ?? 0) * 0.08m).ToString("F2"))</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>Total:</strong>
                                <h5 class="text-primary fw-bold mb-0">$@Model.TotalPrice.ToString("F2")</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ORDER SUMMARY SIDEBAR (RIGHT) -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4 sticky-top summary-card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i> Current Status</h5>
                </div>

                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        @switch (Model.Status)
                        {
                            case "Pending":
                                <i class="fas fa-hourglass fa-4x text-warning"></i>
                                <h5 class="mt-3 mb-2">Order Pending</h5>
                                <p class="text-muted small">Being processed</p>
                                break;
                            case "Confirmed":
                                <i class="fas fa-check-circle fa-4x text-info"></i>
                                <h5 class="mt-3 mb-2">Order Confirmed</h5>
                                <p class="text-muted small">Ready for production</p>
                                break;
                            case "In Production":
                                <i class="fas fa-cog fa-4x text-primary"></i>
                                <h5 class="mt-3 mb-2">In Production</h5>
                                <p class="text-muted small">Being customized</p>
                                break;
                            case "Shipped":
                                <i class="fas fa-truck fa-4x text-info"></i>
                                <h5 class="mt-3 mb-2">Shipped</h5>
                                <p class="text-muted small">On the way to you</p>
                                break;
                            case "Delivered":
                                <i class="fas fa-check-circle fa-4x text-success"></i>
                                <h5 class="mt-3 mb-2">Delivered</h5>
                                <p class="text-muted small">Successfully received</p>
                                break;
                        }
                    </div>

                    <div class="bg-light p-3 rounded">
                        <p class="small text-muted mb-2">
                            <strong>Order Number:</strong><br>
                            <span class="font-monospace">@Model.OrderId</span>
                        </p>
                        <p class="small text-muted mb-2">
                            <strong>Order Date:</strong><br>
                            <span>@Model.OrderDate.ToString("MMMM d, yyyy")</span>
                        </p>
                        <p class="small text-muted">
                            <strong>Estimated Delivery:</strong><br>
                            <span>@Model.OrderDate.AddDays(8).ToString("MMMM d, yyyy")</span>
                        </p>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i> Shipping Address</h5>
                </div>
                <div class="card-body">
                    <p class="small mb-0">
                        <strong>@(Model.Customer?.FullName ?? "Customer")</strong><br>
                        @Model.ShippingAddress<br>
                        <br>
                        <strong>Phone:</strong> @(Model.Customer?.PhoneNumber ?? "N/A")<br>
                        <strong>Email:</strong> @(Model.Customer?.Email ?? "N/A")
                    </p>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-cog me-2"></i> Actions</h5>
                </div>
                <div class="card-body">
                    <button class="btn btn-outline-primary w-100 mb-2" onclick="window.print()">
                        <i class="fas fa-print me-2"></i> Print Order
                    </button>
                    <a asp-action="History" asp-controller="Order" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-history me-2"></i> View All Orders
                    </a>
                </div>
            </div>

            <div class="alert alert-info mt-4" role="alert">
                <i class="fas fa-question-circle me-2"></i>
                <strong>Need Help?</strong><br>
                <small>Contact support for assistance.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/track.js"></script>
}