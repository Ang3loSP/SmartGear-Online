@*
    Admin Dashboard (Admin/Dashboard.cshtml)
    Purpose: Display sales analytics, top products, and inventory alerts
    Question 4: Views - Admin dashboard with charts and metrics
*@

@using SmartGear_Online.Models.ViewModels
@using System.Text.Json
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard - SmartGear Online";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<div class="container-fluid my-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1>Admin Dashboard</h1>
            <p class="text-muted">Welcome back! Here's your business overview.</p>
        </div>

        <div class="btn-group">
            <button class="btn btn-outline-secondary active" onclick="filterByPeriod('month')">This Month</button>
            <button class="btn btn-outline-secondary" onclick="filterByPeriod('quarter')">This Quarter</button>
            <button class="btn btn-outline-secondary" onclick="filterByPeriod('year')">This Year</button>
        </div>
    </div>

    <!-- KEY METRICS CARDS -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-left-primary h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small">Total Revenue</p>
                            <h3 class="text-primary fw-bold mb-0">@("R" + Model.TotalRevenue.ToString("F2"))</h3>
                        </div>
                        <i class="fas fa-dollar-sign fa-3x text-primary opacity-50"></i>
                    </div>
                    <small class="text-success"><i class="fas fa-arrow-up me-1"></i> 12% increase</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-left-success h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small">Total Orders</p>
                            <h3 class="text-success fw-bold mb-0">@Model.TotalOrders</h3>
                        </div>
                        <i class="fas fa-shopping-cart fa-3x text-success opacity-50"></i>
                    </div>
                    <small class="text-success"><i class="fas fa-arrow-up me-1"></i> 8% increase</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-left-warning h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small">Total Customers</p>
                            <h3 class="text-warning fw-bold mb-0">@Model.TotalCustomers</h3>
                        </div>
                        <i class="fas fa-users fa-3x text-warning opacity-50"></i>
                    </div>
                    <small class="text-success"><i class="fas fa-arrow-up me-1"></i> 5% new</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-left-info h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small">Avg. Order Value</p>
                            <h3 class="text-info fw-bold mb-0">@("R" + Model.AverageOrderValue.ToString("F2"))</h3>
                        </div>
                        <i class="fas fa-chart-line fa-3x text-info opacity-50"></i>
                    </div>
                    <small class="text-success"><i class="fas fa-arrow-up me-1"></i> 3% increase</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <!-- REVENUE CHART -->
        <div class="col-lg-8 mb-4 mb-lg-0">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i> Revenue This Month</h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" style="height: 300px; width: 100%;"></canvas>
                </div>
            </div>
        </div>

        <!-- QUICK STATS -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-trending-up me-2"></i> Performance Metrics</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Conversion Rate:</span>
                        <span class="fw-bold">3.5%</span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-success" style="width: 35%;"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Customer Retention:</span>
                        <span class="fw-bold">78%</span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-info" style="width: 78%;"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Customer Satisfaction:</span>
                        <span class="fw-bold">4.7/5</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-success" style="width: 94%;"></div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i> Orders by Status</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2"><span class="badge bg-warning">Pending:</span><span class="fw-bold">@Model.PendingOrders</span></div>
                    <div class="d-flex justify-content-between mb-2"><span class="badge bg-info">Confirmed:</span><span class="fw-bold">@Model.ConfirmedOrders</span></div>
                    <div class="d-flex justify-content-between mb-2"><span class="badge bg-primary">In Production:</span><span class="fw-bold">@Model.ProductionOrders</span></div>
                    <div class="d-flex justify-content-between mb-2"><span class="badge bg-success">Shipped:</span><span class="fw-bold">@Model.ShippedOrders</span></div>
                    <div class="d-flex justify-content-between"><span class="badge bg-secondary">Delivered:</span><span class="fw-bold">@Model.DeliveredOrders</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- TOP PRODUCTS -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-star me-2"></i> Top Selling Products</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Product</th><th>Units</th><th>Revenue</th><th>Trend</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.TopProducts)
                            {
                                <tr>
                                    <td><strong>@product.ProductName</strong><br><small>@product.Category</small></td>
                                    <td>@product.UnitsSold</td>
                                    <td>@("R" + product.Revenue.ToString("F2"))</td>
                                    <td class="text-@product.TrendColor"><i class="fas fa-@product.TrendIcon me-1"></i>@product.Trend.ToString("F0")%</td>
                                </tr>
                            }
                            @if (!Model.TopProducts.Any())
                            {
                                <tr><td colspan="4" class="text-muted text-center py-3">No sales data yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- LOW STOCK ALERTS -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i> Low Stock Alerts</h5>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.LowStockAlerts)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">@item.ProductName</h6>
                                <small class="text-muted">Only @item.CurrentStock units remaining (reorder at @item.ReorderLevel)</small>
                            </div>
                            <a asp-controller="Admin" asp-action="Inventory" class="btn btn-sm @(item.AlertLevel == "Critical" ? "btn-danger" : "btn-warning")">REORDER</a>
                        </div>
                    }
                    @if (!Model.LowStockAlerts.Any())
                    {
                        <div class="list-group-item text-muted">All products are above their reorder levels.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-2"><a href="#" class="btn btn-outline-primary w-100"><i class="fas fa-chart-bar me-2"></i>View Reports</a></div>
                        <div class="col-md-3 mb-2"><a asp-action="Inventory" asp-controller="Admin" class="btn btn-outline-primary w-100"><i class="fas fa-box me-2"></i>Manage Inventory</a></div>
                        <div class="col-md-3 mb-2"><a asp-action="AddProduct" asp-controller="Admin" class="btn btn-outline-primary w-100"><i class="fas fa-plus me-2"></i>Add Product</a></div>
                        <div class="col-md-3 mb-2"><a href="#" class="btn btn-outline-primary w-100"><i class="fas fa-users me-2"></i>View Customers</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.__dailyRevenue = @Html.Raw(JsonSerializer.Serialize(Model.DailyRevenue.Select(d => new { d.DateLabel, d.Revenue, d.OrderCount })));
    </script>
    <script src="~/js/admin-dashboard.js"></script>
}