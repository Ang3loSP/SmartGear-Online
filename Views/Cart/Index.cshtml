@*
    Shopping Cart Page (Cart/Index.cshtml)
    Purpose: Display shopping cart items, allow quantity modification, discount codes, and proceed to checkout
    Question 4: Views - Cart management with dynamic calculations
*@

@model List<SmartGear_Online.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart - SmartGear Online";
}

<!-- Link to external CSS file -->
<link rel="stylesheet" href="~/css/cart.css" />

<div class="container my-5">
    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="mb-2">Your Shopping Cart</h1>
        <p class="text-muted">
            @if (Model != null && Model.Count > 0)
            {
                <span>@Model.Count item(s) in your cart</span>
            }
            else
            {
                <span>Your cart is empty</span>
            }
        </p>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            <!-- CART ITEMS SECTION (LEFT) -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-shopping-bag me-2"></i> Cart Items
                        </h5>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0 cart-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th style="width: 100px;">Price</th>
                                    <th style="width: 120px;">Quantity</th>
                                    <th style="width: 100px;">Total</th>
                                    <th style="width: 80px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="cart-item" data-item-id="@item.CartItemId" data-price="@item.Price">
                                        <!-- Product Info -->
                                        <td>
                                            <div class="d-flex gap-3">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.ProductName"
                                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;">
                                                }
                                                else
                                                {
                                                    <div style="width: 60px; height: 60px; background-color: #e9ecef; border-radius: 5px;"
                                                         class="d-flex align-items-center justify-content-center">
                                                        <i class="fas fa-image text-muted"></i>
                                                    </div>
                                                }

                                                <div>
                                                    <h6 class="mb-1">@item.ProductName</h6>
                                                    @if (!string.IsNullOrEmpty(item.Color))
                                                    {
                                                        <small class="text-muted">
                                                            Color: <span class="badge bg-secondary">@item.Color</span>
                                                        </small>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.CustomText))
                                                    {
                                                        <br>
                                                        <small class="text-muted">
                                                            Text: <em>@item.CustomText</em>
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Price -->
                                        <td class="align-middle">
                                            <span class="fw-bold">$@item.Price.ToString("F2")</span>
                                        </td>

                                        <!-- Quantity Controls -->
                                        <td class="align-middle">
                                            <div class="input-group quantity-control" style="width: 120px;">
                                                <button class="btn btn-sm btn-outline-secondary qty-btn qty-decrease"
                                                        type="button" title="Decrease Quantity">
                                                    <i class="fas fa-minus"></i>
                                                </button>

                                                <input type="number" class="form-control form-control-sm text-center qty-input"
                                                       value="@item.Quantity" min="1" max="100" data-item-id="@item.CartItemId">

                                                <button class="btn btn-sm btn-outline-secondary qty-btn qty-increase"
                                                        type="button" title="Increase Quantity">
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                            </div>
                                        </td>

                                        <!-- Line Total -->
                                        <td class="align-middle">
                                            <span class="fw-bold text-primary">
                                                $<span class="line-total">@((item.Quantity * item.Price).ToString("F2"))</span>
                                            </span>
                                        </td>

                                        <!-- Remove Button -->
                                        <td class="align-middle">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-item-btn"
                                                    data-item-id="@item.CartItemId" title="Remove Item">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Continue Shopping Button -->
                    <div class="card-footer bg-light">
                        <a asp-action="Index" asp-controller="Product" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i> Continue Shopping
                        </a>
                    </div>
                </div>
            </div>

            <!-- ORDER SUMMARY SECTION (RIGHT) -->
            <div class="col-lg-4">
                <div class="card shadow-sm mb-3 order-summary-card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-receipt me-2"></i> Order Summary
                        </h5>
                    </div>

                    <div class="card-body">
                        <!-- Subtotal -->
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span id="subtotal">$0.00</span>
                        </div>

                        <!-- Shipping -->
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            <span id="shipping" class="text-success fw-bold">FREE</span>
                        </div>

                        <!-- Discount -->
                        <div class="d-flex justify-content-between mb-3 pb-3 border-bottom"
                             id="discountRow" style="display: none;">
                            <span>Discount:</span>
                            <span id="discountAmount" class="text-success">-$0.00</span>
                        </div>

                        <!-- Tax -->
                        <div class="d-flex justify-content-between mb-3">
                            <span>Tax (8%):</span>
                            <span id="tax">$0.00</span>
                        </div>

                        <!-- Total -->
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-top pt-3">
                            <strong class="fs-5">Total:</strong>
                            <h5 class="text-primary fw-bold mb-0">
                                $<span id="total">0.00</span>
                            </h5>
                        </div>

                        <!-- Discount Code Section -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small">
                                <i class="fas fa-tag me-1"></i> Discount Code (Optional)
                            </label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm discount-input"
                                       id="discountCode" placeholder="Enter code" maxlength="20">
                                <button class="btn btn-sm btn-outline-secondary" id="applyDiscountBtn" type="button">
                                    Apply
                                </button>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Try: SAVE10, SAVE20, or FIRST25
                            </small>
                        </div>

                        <!-- Checkout Button -->
                        <a asp-action="Checkout" asp-controller="Order" class="btn btn-primary btn-lg w-100 mb-2">
                            <i class="fas fa-lock me-2"></i> Proceed to Checkout
                        </a>

                        <!-- Continue Shopping Button -->
                        <a asp-action="Index" asp-controller="Product" class="btn btn-outline-secondary btn-sm w-100">
                            <i class="fas fa-shopping-bag me-2"></i> Continue Shopping
                        </a>
                    </div>
                </div>

                <!-- Security Info -->
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-shield-alt me-2"></i>
                    <strong>Secure Checkout:</strong> Your payment information is encrypted and secure.
                </div>

                <!-- Benefits List -->
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title fw-bold mb-3">Why Shop with SmartGear?</h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <strong>Fast Shipping:</strong> 3-7 business days
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <strong>Money-Back:</strong> 30-day guarantee
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <strong>Free Returns:</strong> Easy returns process
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <strong>24/7 Support:</strong> We're here to help
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty Cart State -->
        <div class="row justify-content-center">
            <div class="col-md-6 text-center py-5">
                <i class="fas fa-shopping-cart fa-5x text-muted mb-4"></i>
                <h3 class="mb-3">Your Cart is Empty</h3>
                <p class="text-muted mb-4">
                    It looks like you haven't added any products to your cart yet.
                </p>
                <a asp-action="Index" asp-controller="Product" class="btn btn-primary btn-lg">
                    <i class="fas fa-shopping-bag me-2"></i> Start Shopping
                </a>
            </div>
        </div>
    }
</div>

<!-- Include external JavaScript file -->
<script src="~/js/cart.js"></script>