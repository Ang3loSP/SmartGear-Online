<!-- Question 7: Footer - Consistent Across All Pages -->

<footer class="bg-dark text-white-50 mt-5 py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-3 mb-md-0">
                <h5 class="text-white mb-3">SmartGear</h5>
                <p class="small">Your one-stop shop for custom sports equipment and team apparel.</p>
                <!--
                    FIX: social links left as # intentionally — this is a
                    student project with no live social media presence yet.
                    Replace with real URLs once accounts exist, or remove
                    the icons below if they won't be used.
                -->
                <div>
                    <a href="#" class="text-white-50 me-3" aria-label="Facebook (not yet live)"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="text-white-50 me-3" aria-label="Twitter (not yet live)"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="text-white-50 me-3" aria-label="Instagram (not yet live)"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
            <div class="col-md-2 mb-3 mb-md-0">
                <h6 class="text-white mb-3">Quick Links</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Home</a></li>
                    <li class="mb-2"><a asp-controller="Product" asp-action="Index" class="text-white-50 text-decoration-none">Products</a></li>
                    <li class="mb-2"><a asp-controller="Home" asp-action="About" class="text-white-50 text-decoration-none">About</a></li>
                    <li class="mb-2"><a asp-controller="Home" asp-action="Contact" class="text-white-50 text-decoration-none">Contact</a></li>
                </ul>
            </div>
            <div class="col-md-3 mb-3 mb-md-0">
                <h6 class="text-white mb-3">Customer Service</h6>
                <ul class="list-unstyled small">
                    <!--
                        FIX: Shipping Info, Returns Policy & FAQ pages don't
                        exist yet, so those links were removed rather than
                        left as dead "#" anchors. Privacy Policy now routes
                        to the real page. Add the other three back here
                        once those pages are built.
                    -->
                    <li class="mb-2"><a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none">Privacy Policy</a></li>
                    <li class="mb-2"><a asp-controller="Home" asp-action="Contact" class="text-white-50 text-decoration-none">Contact Support</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="text-white mb-3">Contact Us</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2"><i class="fas fa-envelope me-2"></i> support@smartgear.com</li>
                    <li class="mb-2"><i class="fas fa-phone me-2"></i> +27 (0) 11 234 5678</li>
                    <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i> Johannesburg, South Africa</li>
                </ul>
            </div>
        </div>
        <hr class="mt-4">
        <div class="text-center small">
            &copy; @DateTime.Now.Year SmartGear Online. All rights reserved.
        </div>
    </div>
</footer>
