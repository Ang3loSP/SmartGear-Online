@{
    ViewData["Title"] = "Error";
}

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <i class="fas fa-exclamation-triangle fa-5x text-danger mb-4" aria-hidden="true"></i>
            <h1 class="display-4 mb-3">Oops! Something went wrong.</h1>
            <p class="lead text-muted mb-4">We encountered an unexpected error and could not complete your request.</p>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger text-start" role="alert" aria-live="polite">@ViewBag.ErrorMessage</div>
            }

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-home me-2" aria-hidden="true"></i> Back to Home
                </a>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary">
                    <i class="fas fa-headset me-2" aria-hidden="true"></i> Contact Support
                </a>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.RequestId))
            {
                <p class="text-muted small mt-4 mb-0">
                    If the problem continues, please quote this reference when you contact us:
                    <strong>@ViewBag.RequestId</strong>
                </p>
            }
        </div>
    </div>
</div>