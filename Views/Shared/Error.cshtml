@{
    ViewData["Title"] = "Error";
}

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <i class="fas fa-exclamation-triangle fa-5x text-danger mb-4"></i>
            <h1 class="display-4 mb-3">Oops! Something went wrong.</h1>
            <p class="lead text-muted mb-4">We encountered an unexpected error. Please try again later.</p>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-home me-2"></i> Back to Home
                </a>
                <button class="btn btn-outline-secondary ms-2" onclick="location.reload()">
                    <i class="fas fa-sync-alt me-2"></i> Try Again
                </button>
            </div>

            <hr class="my-4">
            <p class="text-muted small">
                Error Reference: @ViewBag.RequestId
            </p>
        </div>
    </div>
</div>