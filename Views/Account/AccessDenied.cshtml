@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container mt-5" style="max-width: 550px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white text-center py-3">
            <h4 class="mb-0">
                <i class="fas fa-lock me-2"></i>Access Denied
            </h4>
        </div>
        <div class="card-body p-4 text-center">
            <i class="fas fa-ban fa-4x text-danger mb-4"></i>
            <h5 class="mb-3">You don't have permission to view this page</h5>
            <p class="text-muted mb-4">
                This area is restricted. If you believe this is a mistake,
                please contact the site administrator.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-home me-2"></i>Go to Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                    <i class="fas fa-sign-in-alt me-2"></i>Login with a different account
                </a>
            </div>
        </div>
    </div>
</div>
